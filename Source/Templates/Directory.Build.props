<Project>
  <!-- Chain up to Source/Directory.Build.props for the package-version split
       (VersionPrefix/VersionSuffix). The per-template Directory.Build.Props
       imports THIS file, which stops MSBuild's own walk-up here, so without this
       import the version logic above never applies: VersionPrefix/VersionSuffix
       stay empty and Net4x.NuGetUtility (Windows) rebuilds the version as a bare
       ".", failing the pack with NU5024. -->
  <PropertyGroup>
    <ParentDirectoryBuildProps>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))</ParentDirectoryBuildProps>
  </PropertyGroup>
  <Import Project="$(ParentDirectoryBuildProps)" Condition="'$(ParentDirectoryBuildProps)'!=''" />
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageIcon>Icon.png</PackageIcon>
    <Authors>GtkSharp Contributors</Authors>
    <PackageProjectUrl>https://gtksharp4.github.io/GtkSharp/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gtksharp4/GtkSharp</RepositoryUrl>
    <OutputPath>..\..\..\BuildOutput\$(Configuration)</OutputPath>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>NU5128</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- The explicit None below packs README.md at the package root. Without this
         exclude the SDK default None glob picks it up as well, NuGet sees two
         items for the same target path and the package ships it twice, which
         nuget.org rejects as a duplicated file. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);README.md</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>